# Particle Trace Environment Configuration
# Copy this file to .env and fill in your Cloudflare R2 credentials if publishing.

# Cloudflare R2 Configuration (Optional for local demo mode)
R2_BUCKET_NAME=particle-trace-data
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PREFIX=colliderml-release-1

# Pipeline Paths
PARTICLE_TRACE_OUTPUT_DIR=./data/processed
PARTICLE_TRACE_FIXTURES_DIR=./data/fixtures
PARTICLE_TRACE_CACHE_DIR=./.cache/colliderml
